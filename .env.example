# ---- Ingest -------------------------------------------------------------
# HyperSync made API tokens MANDATORY in Nov 2025. Free tier is plenty here.
# Get one: https://envio.dev/app/api-tokens
ENVIO_API_TOKEN=
HYPERSYNC_URL=https://eth.hypersync.xyz

# ---- State reads --------------------------------------------------------
# Comma-separated. MORE ENDPOINTS = MORE THROUGHPUT: the engine round-robins
# across them, so 4 free keys beat 1 paid key for this workload.
# Free tiers that work well: Alchemy, Ankr, drpc, LlamaRPC, PublicNode.
RPC_URLS=https://eth.llamarpc.com,https://rpc.ankr.com/eth,https://ethereum-rpc.publicnode.com

# ---- Database -----------------------------------------------------------
# Any Postgres. Supabase / Neon / RDS / local docker all work unchanged.
DATABASE_URL=postgresql://user:pass@localhost:5432/liqarch

# ---- Scan tuning --------------------------------------------------------
MIN_LOCKED_USD=100
END_BLOCK=18908895
MULTICALL_BATCH_SIZE=400
RPC_CONCURRENCY=24
